# Server Environment Configuration Template

PORT=5000
CLIENT_URL=https://vedanta-makeathon.vercel.app

# Admin Security Credentials
ADMIN_EMAIL=admin@dakshina.org
ADMIN_PASSWORD=your_secure_admin_password
JWT_SECRET=your_random_secret_string_here

# Official Contact/Mailer Recipient
CONTACT_EMAIL=Dakshinaasyadarshini@jyothyit.ac.in

# Supabase Database Credentials
SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_SERVICE_ROLE=your-supabase-service-role-key

# Google Drive Storage Config (Primary)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=your-google-drive-folder-id

# Cloudflare R2 Storage Config (Legacy/Fallback)
R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_r2_bucket_name
